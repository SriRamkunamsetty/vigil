# Copy to .env for local development. Never commit real secrets.
# ---- Runtime ----
VIGIL_ENV=dev                      # dev | prod  (prod refuses to start without auth)
VIGIL_AUTH_MODE=demo               # demo | apikey
VIGIL_API_KEYS=                    # comma-separated SHA-256 hex digests of accepted API keys (apikey mode)
VIGIL_CORS_ORIGINS=                # comma-separated origins; empty = same-origin only
VIGIL_RATE_LIMIT_PER_MIN=120

# ---- Gemini / Vertex AI (optional: the deterministic engine works without it) ----
VIGIL_LLM_ENABLED=false
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VIGIL_MODEL_REASONING=gemini-3.5-flash
VIGIL_MODEL_FAST=gemini-3.1-flash-lite
VIGIL_MODEL_LIVE=gemini-3.1-flash-live-preview

# ---- Cross-bank signal exchange ----
VIGIL_SIGNAL_KEY=                  # base64 consortium HMAC key (use Secret Manager in cloud)
VIGIL_SIGNAL_MIN_REPORTERS=2
VIGIL_SIGNAL_TTL_DAYS=30
